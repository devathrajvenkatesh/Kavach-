# Possessed Butler - Environment Variables Example
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# LLM Orchestrator
ANTHROPIC_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Security & Gateway Settings (Mission Extension Points)
SECURITY_ENFORCEMENT_MODE=strict
AUDIT_LOG_LEVEL=info
