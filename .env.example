# Kavach - Environment Variables Example
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# LLM Provider Selection
# Options: mock | gemini | anthropic | openai | groq
# Default for development and testing: mock (requires zero external credentials)
LLM_PROVIDER=mock

# Gemini Provider Configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Provider Configuration (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Provider Configuration (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI Provider Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Kavach Administrator Configuration
# Exact verified email address of the sole authorized system administrator (Project Owner)
KAVACH_ADMIN_EMAIL=security-admin@yourcompany.com
ADMIN_EMAIL=security-admin@yourcompany.com

# Server-Side Authentication Secret
# 32+ character high-entropy secret used for HMAC session tokens and state signing
AUTH_SECRET=

# Server-Side Token Encryption Secret (AES-256-GCM)
# 32+ character high-entropy secret used to encrypt OAuth refresh credentials at rest
TOKEN_ENCRYPTION_KEY=

# Google OAuth Credentials (Google Sign-In & Gmail Read-Only Integration)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Azure OAuth Credentials (Microsoft 365 / Outlook Integration)
# Register application in Azure Portal (App registrations)
# Supported account types: Accounts in any organizational directory and personal Microsoft accounts
# Authorized redirect URI:
#   http://localhost:3000/api/mail/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/mail/microsoft/callback

# Authoritative Production Database Configuration
# REQUIRED for production deployment on Vercel (Neon, Supabase, AWS RDS, etc.)
# Kavach fails-closed safely if DATABASE_URL or POSTGRES_URL is missing in production.
# Ephemeral storage, /tmp fallbacks, and SQLite are strictly prohibited in production.
# For local development and automated tests, SQLite (.kavach-data/kavach.sqlite or :memory:) is used when omitted.
DATABASE_URL=postgres://user:password@host:5432/kavach?sslmode=require
# POSTGRES_URL=postgres://user:password@host:5432/kavach?sslmode=require
# Optional connection pool maximum (default: 10)
# DATABASE_POOL_MAX=10

# Application Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Policy & Audit Settings
SECURITY_ENFORCEMENT_MODE=strict
AUDIT_LOG_LEVEL=info
